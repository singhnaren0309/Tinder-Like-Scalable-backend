# ==========================================================
# Tinder Backend Scalable Architecture Configuration
# ==========================================================

# Port Configuration
GATEWAY_PORT=8080
PROFILE_SERVICE_PORT=8081
SWIPE_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# Service URLs (for Gateway routing)
PROFILE_SERVICE_URL=http://localhost:8081
SWIPE_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083

# JWT Authentication
JWT_SECRET=tinder_super_secret_jwt_key_scalable_2026
JWT_EXPIRES_IN=7d

# PostgreSQL (User Profiles, Settings, Matches)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tinder_profile_db
POSTGRES_SSL=false

# Cassandra / ScyllaDB (High WPS Swipes)
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=tinder_swipe_keyspace

# Redis (Atomic Match Detection, Feed Stack Cache, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka (CDC & Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tinder-backend
KAFKA_TOPIC_PROFILE_EVENTS=tinder.profile.events
KAFKA_TOPIC_SWIPE_EVENTS=tinder.swipe.events
KAFKA_TOPIC_MATCH_EVENTS=tinder.match.events

# Elasticsearch (Geospatial Feed Querying)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=tinder_profiles

# Rate Limiter
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
SWIPE_RATE_LIMIT_WINDOW_MS=86400000
SWIPE_MAX_PER_DAY=100

# Feed Engine Configuration
FEED_STACK_BATCH_SIZE=20
CRON_FEED_INTERVAL=*/10 * * * *

# Graceful Infrastructure Fallback (if real Docker DBs are not booted)
USE_MOCK_INFRA_FALLBACK=true

